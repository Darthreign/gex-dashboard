# Copie ce fichier en .env (jamais commité) OU définis ces variables dans ton
# environnement. Le token du bot est un SECRET.

DISCORD_BOT_TOKEN=colle-ici-le-token-du-bot
DISCORD_CHANNEL_ID=123456789012345678
# URL du dashboard GEX qui tourne sur la même machine (défaut si absent) :
DASHBOARD_URL=http://127.0.0.1:8050
